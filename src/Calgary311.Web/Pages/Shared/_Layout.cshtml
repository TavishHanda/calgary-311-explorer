<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Calgary 311 Explorer</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">Calgary 311 Explorer</a>
        <nav>
            <a asp-page="/Index">Home</a>
            <a asp-page="/Requests/Index">Browse</a>
            @* TODO: add a Dashboard link once it's built *@
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        Data: <a href="https://data.calgary.ca/Services-and-Amenities/311-Service-Requests/iahh-g8bj">City of Calgary Open Data, 311 Service Requests</a>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
