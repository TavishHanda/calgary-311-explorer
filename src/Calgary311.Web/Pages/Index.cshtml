@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h1>Calgary 311 Explorer</h1>
<p class="lead">Browse and analyze 311 service requests from the City of Calgary's open data portal.</p>

@if (Model.SetupMessage is not null)
{
    <div class="notice">@Model.SetupMessage</div>
}
else
{
    <dl class="stats">
        <div>
            <dt>Requests stored</dt>
            <dd>@Model.TotalRequests.ToString("N0")</dd>
        </div>
        <div>
            <dt>Newest request</dt>
            <dd>@(Model.NewestRequest?.ToString("MMM d, yyyy") ?? "None yet")</dd>
        </div>
    </dl>

    @if (Model.SyncMessage is not null)
    {
        <div class="notice">@Model.SyncMessage</div>
    }

    @if (Model.TotalRequests > 0)
    {
        <p><a asp-page="/Requests/Index">Browse and search all @Model.TotalRequests.ToString("N0") requests →</a></p>
    }
    else
    {
        @if (Model.AutoSync)
        {
            <p>
                The database is empty. The app loads the last @Model.InitialSyncDays days of requests from the City's API
                in the background when it starts, which takes a few minutes. Refresh to check on it, or sync now.
            </p>
        }
        else
        {
            <p>The database is empty. Sync to load the last @Model.InitialSyncDays days of requests from the City's API (a few minutes).</p>
        }
    }

    <form method="post" asp-page-handler="Sync" class="sync-form"
          onsubmit="const b = this.querySelector('button'); b.disabled = true; b.textContent = 'Syncing…';">
        <button type="submit" class="button">Sync from Open Calgary</button>
    </form>
}
